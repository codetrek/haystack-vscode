{
  "name": "haystack-search",
  "displayName": "Haystack Search",
  "description": "A VS Code extension that integrates Haystack for advanced file search capabilities.",
  "version": "1.3.1",
  "publisher": "codetrek",
  "haystackVersion": "1.5.1",
  "repository": "https://github.com/ai-microsoft/haystack-vscode",
  "icon": "resources/icon.png",
  "author": {
    "name": "Jianjun Chen",
    "email": "sychenjianjun@gmail.com"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "watch": "run-p watch:dev:*",
    "watch:prod": "run-p watch:prod:*",
    "watch:dev:ext": "cross-env NODE_ENV=development webpack --config ./webpack/extension.config.js --watch",
    "watch:prod:ext": "cross-env NODE_ENV=production webpack --config ./webpack/extension.config.js --watch",
    "watch:dev:wv": "cross-env NODE_ENV=development webpack serve --config ./webpack/webview.config.js",
    "watch:prod:wv": "cross-env NODE_ENV=production webpack serve --config ./webpack/webview.config.js",
    "build:prod:ext": "cross-env NODE_ENV=production webpack --config ./webpack/extension.config.js",
    "build:prod:wv": "cross-env NODE_ENV=production webpack --config ./webpack/webview.config.js",
    "build:dev:ext": "cross-env NODE_ENV=development webpack --config ./webpack/extension.config.js",
    "build:dev:wv": "cross-env NODE_ENV=development webpack --config ./webpack/webview.config.js",
    "build:test:ext": "cross-env NODE_ENV=test webpack --config ./webpack/extension.config.js",
    "build:test:wv": "cross-env NODE_ENV=test webpack --config ./webpack/webview.config.js",
    "build:prod": "run-s clean build:prod:*",
    "build:dev": "run-s clean build:dev:*",
    "build:test": "run-s clean build:test:*",
    "test": "cross-env NODE_ENV=test vscode-test",
    "test:e2e:build": "tsc -p tsconfig.e2e.json",
    "test:e2e:extest": "extest setup-and-run 'out/e2e/**/*.e2e.js' --code_version=1.100.3 --extensions_dir=./dist",
    "test:e2e": "run-s build:test test:e2e:build test:e2e:extest",
    "publish": "npm run build && vsce publish",
    "clean": "rimraf dist && rimraf out",
    "analyze": "cross-env NODE_ENV=production webpack --config ./webpack/extension.config.js --analyze && webpack --config ./webpack/webview.config.js --analyze",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,css,md,mjs,cjs}\"",
    "prepare": "husky install",
    "pretest": "npm run clean && tsc -p tsconfig.test.json && tsc-alias -p tsconfig.test.json"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "haystack-search",
          "title": "Haystack",
          "icon": "resources/search.svg"
        }
      ]
    },
    "views": {
      "haystack-search": [
        {
          "id": "haystackSearch",
          "name": "Search",
          "type": "webview",
          "retainContextWhenHidden": true
        }
      ]
    },
    "configuration": {
      "title": "Haystack Search",
      "properties": {
        "haystack.search.maxResults": {
          "type": "number",
          "default": 5000,
          "minimum": 10,
          "maximum": 50000,
          "description": "Maximum number of search results to return"
        },
        "haystack.search.maxResultsPerFile": {
          "type": "number",
          "default": 500,
          "minimum": 5,
          "maximum": 1000,
          "description": "Maximum number of search results to return per file"
        },
        "haystack.search.useGlobalFilters": {
          "type": "boolean",
          "default": true,
          "description": "Use global filters for Haystack search"
        },
        "haystack.search.exclude.useGitIgnore": {
          "type": "boolean",
          "default": false,
          "description": "Use .gitignore to exclude files from Haystack search"
        },
        "haystack.search.exclude.custom": {
          "type": "array",
          "default": [
            "node_modules/",
            "dist/",
            "build/",
            "vendor/",
            "out/",
            "obj/",
            "log/",
            "logs/",
            ".*",
            "*.log",
            "*.log.*"
          ],
          "items": {
            "type": "string"
          },
          "description": "Custom file patterns to exclude from Haystack search"
        },
        "haystack.search.include": {
          "type": "array",
          "default": [
            "**/*"
          ],
          "items": {
            "type": "string"
          },
          "description": "File patterns to include in Haystack search, `**/*` for all files, `*.js` for JavaScript files, etc."
        }
      }
    },
    "commands": [
      {
        "command": "haystack.searchSelectedText",
        "title": "Search with Haystack"
      },
      {
        "command": "haystack.syncWorkspace",
        "title": "Refresh Haystack Index",
        "icon": "$(sync)"
      },
      {
        "command": "haystack.openSettings",
        "title": "Haystack Settings",
        "icon": "$(gear)"
      },
      {
        "command": "haystack.startServer",
        "title": "Start Haystack Server",
        "icon": "$(debug-start)"
      },
      {
        "command": "haystack.cancelSearch",
        "title": "Cancel Searching (ESC)",
        "icon": "$(stop-circle)"
      },
      {
        "command": "haystack.searchFunctionSymbols",
        "title": "Haystack Search Function Symbols"
      },
      {
        "command": "haystack.searchFiles",
        "title": "Haystack Search Files"
      }
    ],
    "keybindings": [
      {
        "command": "haystack.searchSelectedText"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "haystack.startServer",
          "when": "view == haystackSearch && haystackInstalled && !haystackConnected",
          "group": "navigation@0"
        },
        {
          "command": "haystack.cancelSearch",
          "when": "view == haystackSearch && haystackSearching",
          "group": "navigation@1"
        },
        {
          "command": "haystack.syncWorkspace",
          "when": "view == haystackSearch",
          "group": "navigation@2"
        },
        {
          "command": "haystack.openSettings",
          "when": "view == haystackSearch",
          "group": "navigation@3"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "haystack_search",
        "displayName": "Search Content",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "haystack_search",
        "modelDescription": "Search for code in current workspace, supports prefix matching and logical operators to help you find exactly what you're looking for in your codebase.",
        "userDescription": "Search for code in current workspace.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "The search query. Supports the following syntax features:\n- Basic terms: single words like 'function'\n- Prefix matching: 'func*' matches 'function', 'functional', etc. (wildcard only at end of term)\n- Exact matching for quoted phrases: '\"Second third\"' matches 'preSecond thirdSuf' but not 'preSecond and thirdSuf'\n- Logical operators: 'AND' (or space) for conjunction, '|' for OR operator\n- Examples: 'error AND handle', 'create | update', 'init*'"
            },
            "workspace": {
              "type": "string",
              "description": "The workspace to search in, normally it's the absolute path to the project directory, e.g. /home/user/projects/project1. Please always passing current workspace path."
            },
            "path": {
              "type": "string",
              "description": "The path to search in, related to workspace, e.g. src/core"
            },
            "filter": {
              "type": "string",
              "description": "Filter the search results by file path. The filter supports glob patterns, separated by comma(','), e.g. 'src/**/*.go,*.cc' to search only in Go files in the src directory or *.cc files in all directory."
            },
            "exclude": {
              "type": "string",
              "description": "Exclude files from the search. The exclude filter supports glob patterns, separated by comma, e.g. 'test/**/*.go' to exclude all Go test files."
            },
            "limit": {
              "type": "integer",
              "description": "Maximum number of results to return. The search will stop once this limit is reached, which can improve performance for large codebases."
            }
          },
          "required": [
            "query",
            "workspace"
          ]
        }
      },
      {
        "name": "haystack_files",
        "displayName": "Search Files",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "haystack_search",
        "modelDescription": "Search files (for filename or path) in current workspace, supports fuzzy matching on filenames and attempts to return a list of the most relevant files",
        "userDescription": "Search files in current workspace.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "The search query (for filename / path) which is case-insensitive. Fuzzy match\ne.g. query 'savedtabgroup' will match 'saved_tab_group', 'src/**/saved/tabgroup'"
            },
            "workspace": {
              "type": "string",
              "description": "The workspace to search in, normally it's the absolute path to the project directory, e.g. /home/user/projects/project1. Please always passing current workspace path."
            },
            "limit": {
              "type": "integer",
              "description": "Maximum number of results to return."
            }
          },
          "required": [
            "query",
            "workspace"
          ]
        }
      }
    ]
  },
  "dependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vscode/codicons": "^0.0.36",
    "adm-zip": "^0.5.16",
    "axios": "^1.6.7",
    "derive-valtio": "^0.2.0",
    "js-yaml": "^4.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "valtio": "^2.1.5"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/js": "^9.27.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.14.0",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.3.2",
    "babel-loader": "^10.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^6.0.0-rc.1",
    "file-loader": "^6.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "react-compiler-webpack": "^0.2.0",
    "rimraf": "^6.0.1",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.14",
    "ts-loader": "^9.5.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vscode-extension-tester": "^8.15.0",
    "vscode-test": "^1.6.1",
    "webpack": "^5.99.5",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.1",
    "webpack-manifest-plugin": "^5.0.1",
    "webpack-merge": "^6.0.1"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json,css,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{js,ts,tsx,mjs,cjs}": [
      "eslint src --fix --max-warnings 0 --no-warn-ignored"
    ]
  }
}
