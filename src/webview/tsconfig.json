{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "rootDir": "../",
    "paths": {
      "@/*": ["../*"]
    },
    "composite": true,
    "declaration": true
  },
  "include": ["**/*.ts", "../message/**/*.ts", "../types/**/*.ts", "../template.ts"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
